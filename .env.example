# Copie este archivo como .env.local y complete los valores de su proyecto Supabase.
# Solo se usa la clave pública "anon" (o "publishable"). NUNCA coloque la clave service_role aquí.
VITE_SUPABASE_URL=https://SU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=su-clave-anon-publica

# Opcional: servidor de teselas compatible con su política de uso.
# Por defecto se usa el servidor estándar de OpenStreetMap (uso ligero, con atribución obligatoria).
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; colaboradores de OpenStreetMap
