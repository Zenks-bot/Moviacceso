{
  "name": "moviacceso",
  "private": true,
  "version": "0.1.0",
  "description": "MoviAcceso — prototipo de plataforma de movilidad urbana inclusiva para Huánuco, Perú",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "osm:import": "tsx scripts/osm-to-dataset.ts",
    "db:test": "bash scripts/db-test.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@supabase/supabase-js": "^2.119.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.63.0"
    }
  }
}
